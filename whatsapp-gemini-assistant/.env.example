# ==========================================
# WhatsApp Gemini AI Assistant Configuration
# ==========================================

# 1. Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Gemini Model Choice:
# Recommended: gemini-2.5-flash (fast, intelligent, multimodal) or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# 3. Bot Personality & Name
BOT_NAME="Gemini Assistant"
SYSTEM_INSTRUCTION="You are a smart, helpful, friendly personal AI assistant on WhatsApp. Answer concisely and clearly. Format text nicely for WhatsApp (use *bold* for emphasis, _italic_, and bullet points where helpful). If asked about images, analyze them in detail."

# 4. Trigger Configuration
# If AUTO_REPLY_DM is true, the bot replies to ANY incoming 1-on-1 WhatsApp message.
# If AUTO_REPLY_DM is false, the bot only responds when the message starts with TRIGGER_PREFIX (e.g. !ai or !ask).
AUTO_REPLY_DM=true
TRIGGER_PREFIX=!ai

# 5. Group Chats
# If true, the bot can be used in groups, but ALWAYS requires TRIGGER_PREFIX (e.g. '!ai explain this') to prevent spam.
ENABLE_GROUPS=true

# 6. Conversation Memory
# Number of past conversation turns to remember per contact
MAX_HISTORY_TURNS=10
